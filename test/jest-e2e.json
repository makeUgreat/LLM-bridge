{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(ts|js)$": ["ts-jest", { "tsconfig": "test/tsconfig.e2e.json" }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!uuid/)"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}
