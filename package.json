{
  "name": "llm-bridge",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --filter @llm-bridge/api build",
    "start:dev": "pnpm --filter @llm-bridge/api start:dev",
    "lint": "pnpm --filter @llm-bridge/api lint",
    "lint:check": "pnpm --filter @llm-bridge/api lint:check",
    "deps:check": "pnpm --filter @llm-bridge/api deps:check",
    "deps:graph": "pnpm --filter @llm-bridge/api deps:graph",
    "harness:static": "pnpm --filter @llm-bridge/api harness:static",
    "test": "pnpm --filter @llm-bridge/api test",
    "test:unit": "pnpm --filter @llm-bridge/api test:unit",
    "test:integration": "pnpm --filter @llm-bridge/api test:integration",
    "test:integration:all": "pnpm --filter @llm-bridge/api test:integration:all",
    "typecheck": "pnpm --filter @llm-bridge/api typecheck"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@swc/core"]
  }
}
